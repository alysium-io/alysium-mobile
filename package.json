{
	"name": "alysium",
	"version": "1.1.0",
	"private": true,
	"scripts": {
		"android": "react-native run-android",
		"ios": "react-native run-ios",
		"start": "react-native start",
		"test": "jest",
		"lint": "eslint . --ext .js,.jsx,.ts,.tsx",
		"clean": "rm -rf node_modules",
		"start:clean": "watchman watch-del-all && yarn cache clean && yarn start --reset-cache",
		"check-git-clean": "git diff-index --quiet HEAD -- || (echo \"You have uncommitted changes. Please commit or stash them.\"; exit 1)",
		"version:patch": "yarn check-git-clean && yarn version patch && npx react-native-version --never-increment-build",
		"version:minor": "yarn check-git-clean && yarn version minor && npx react-native-version --never-increment-build",
		"version:major": "yarn check-git-clean && yarn version major && npx react-native-version --never-increment-build",
		"android:prod": "npx react-native run-android --variant=prodDebug",
		"android:prod-release": "npx react-native run-android --variant=prodRelease",
		"android:demo": "npx react-native run-android --variant=demoDebug",
		"android:demo-release": "npx react-native run-android --variant=demoRelease",
		"android:qa": "npx react-native run-android --variant=qaDebug",
		"android:qa-release": "npx react-native run-android --variant=qaRelease",
		"android:dev": "npx react-native run-android --variant=devDebug",
		"android:dev-release": "npx react-native run-android --variant=devRelease",
		"android:reverse-tcp": "adb reverse tcp:8081 tcp:8081",
		"android:build:metadata": "bundle exec ruby ./tools/build-android-metadata.rb",
		"link-assets": "npx react-native-asset --plist ./ios/alysium/alysium-demo Info.plist",
		"test:deeplink:artist": "npx uri-scheme open \"alysium://artist/BhBmP0sWGiO582CBQQmZoCN8\" --ios",
		"test:deeplink:event": "npx uri-scheme open \"alysium://artist/event/ZrI2elEfcdaaigsU5hqgtPbc\" --ios"
	},
	"dependencies": {
		"@babel/plugin-proposal-export-namespace-from": "^7.18.9",
		"@gorhom/bottom-sheet": "^5.0.5",
		"@gorhom/portal": "^1.0.14",
		"@react-native-async-storage/async-storage": "^2.1.0",
		"@react-native-clipboard/clipboard": "^1.15.0",
		"@react-native-community/blur": "^4.4.1",
		"@react-native-community/netinfo": "^11.4.1",
		"@react-native-masked-view/masked-view": "^0.3.2",
		"@react-navigation/bottom-tabs": "^7.1.3",
		"@react-navigation/native": "^7.0.13",
		"@react-navigation/native-stack": "^7.1.14",
		"@react-navigation/stack": "^6.3.17",
		"@reduxjs/toolkit": "^2.4.0",
		"@shopify/restyle": "^2.4.2",
		"dayjs": "^1.11.9",
		"lodash": "^4.17.21",
		"moti": "^0.29.0",
		"react": "18.2.0",
		"react-hook-form": "^7.53.2",
		"react-if": "^4.1.5",
		"react-native": "0.74.3",
		"react-native-config": "^1.5.3",
		"react-native-contacts": "^8.0.4",
		"react-native-date-picker": "^5.0.7",
		"react-native-device-info": "^14.0.1",
		"react-native-fast-image": "^8.6.3",
		"react-native-gesture-handler": "^2.21.2",
		"react-native-haptic-feedback": "^2.3.3",
		"react-native-image-picker": "^7.2.2",
		"react-native-linear-gradient": "^2.8.3",
		"react-native-maps": "^1.18.2",
		"react-native-permissions": "^4.0.0",
		"react-native-reanimated": "^3.16.3",
		"react-native-safe-area-context": "^4.14.0",
		"react-native-screens": "^4.3.0",
		"react-native-share": "^11.1.0",
		"react-native-skeleton-placeholder": "^5.2.4",
		"react-native-svg": "^15.9.0",
		"react-native-toast-message": "^2.2.0",
		"react-native-video": "^6.8.2",
		"react-native-view-shot": "^4.0.2",
		"react-redux": "^8.1.2",
		"redux": "^5.0.1",
		"redux-persist": "^6.0.0",
		"yarn": "^1.22.22",
		"yup": "^1.4.0"
	},
	"devDependencies": {
		"@babel/core": "^7.20.0",
		"@babel/runtime": "^7.20.0",
		"@react-native/babel-preset": "0.74.85",
		"@react-native/eslint-config": "0.74.85",
		"@react-native/metro-config": "0.74.85",
		"@react-native/typescript-config": "0.74.85",
		"@types/lodash": "^4.14.196",
		"@types/react": "^18.2.6",
		"@types/react-native": "^0.70.6",
		"@types/react-test-renderer": "^18.0.0",
		"@types/redux-persist": "^4.3.1",
		"@typescript-eslint/eslint-plugin": "^5.37.0",
		"@typescript-eslint/parser": "^5.37.0",
		"babel-jest": "^29.6.3",
		"babel-plugin-module-resolver": "^5.0.0",
		"eslint": "^7.32.0",
		"eslint-import-resolver-babel-module": "^5.3.2",
		"jest": "^29.6.3",
		"prettier": "2.8.8",
		"react-test-renderer": "18.1.0",
		"ts-jest": "29.1.1",
		"typescript": "5.0.4"
	},
	"engines": {
		"node": ">=18"
	},
	"jest": {
		"preset": "react-native",
		"moduleFileExtensions": [
			"ts",
			"tsx",
			"js",
			"jsx",
			"json",
			"node"
		]
	}
}
